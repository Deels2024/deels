{
  "info": {
    "name": "DEELS Contact Discovery API",
    "description": "Requests for contact permission state, phone hash import, VK friends import, suggestions and following found friends.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://mypot.loc"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "email",
      "value": "user@example.ru"
    },
    {
      "key": "password",
      "value": "password"
    },
    {
      "key": "phone_hash",
      "value": "2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae"
    },
    {
      "key": "found_user_id",
      "value": "123"
    },
    {
      "key": "vk_friend_id",
      "value": "123456789"
    }
  ],
  "item": [
    {
      "name": "Auth - Get token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"talend\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth_token",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth_token"
          ]
        },
        "description": "Copy access_token from the response into the collection variable token."
      }
    },
    {
      "name": "Contacts - Prompt state",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/contacts/prompt-state",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "contacts",
            "prompt-state"
          ]
        }
      }
    },
    {
      "name": "Contacts - Deny prompt",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{base_url}}/api/contacts/deny",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "contacts",
            "deny"
          ]
        }
      }
    },
    {
      "name": "Contacts - Import phone hashes",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_hashes\": [\n    \"{{phone_hash}}\"\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/contacts/import",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "contacts",
            "import"
          ]
        },
        "description": "phone_hash must be SHA-256 of the normalized phone string, for example +79991234567."
      }
    },
    {
      "name": "Contacts - Suggestions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/contacts/suggestions",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "contacts",
            "suggestions"
          ]
        }
      }
    },
    {
      "name": "Contacts - Follow suggestions",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_ids\": [\n    {{found_user_id}}\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/contacts/suggestions/follow",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "contacts",
            "suggestions",
            "follow"
          ]
        }
      }
    },
    {
      "name": "VK - Import friends",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vk_friend_ids\": [\n    \"{{vk_friend_id}}\"\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/vk/friends/import",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "vk",
            "friends",
            "import"
          ]
        }
      }
    }
  ]
}
