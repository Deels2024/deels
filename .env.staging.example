APP_NAME=Deels
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=deels_staging
DB_USERNAME=deels
DB_PASSWORD=deels_staging

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=staging@deels.local
MAIL_FROM_NAME="Deels Staging"

DISABLE_JIVOSITE=true

# External production services intentionally disabled/unset in staging template.
# Add only dedicated staging credentials when a specific integration must be tested.
TINKOFF_TERMINAL_KEY=
TINKOFF_SECRET_KEY=
STRIPE_KEY=
STRIPE_SECRET=
TELEGRAM_BOT_TOKEN=
FIREBASE_CREDENTIALS=
