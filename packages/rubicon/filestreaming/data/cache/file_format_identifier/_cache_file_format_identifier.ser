rmat/proFormatSearch.aspx?status=detailReport&id=1356&strPageToDisplay=summary";i:1;s:34:"https://en.wikipedia.org/wiki/WebP";i:2;s:44:"https://developers.google.com/speed/webp/faq";i:3;s:57:"https://developers.google.com/speed/webp/docs/compression";i:4;s:60:"https://developers.google.com/speed/webp/docs/riff_container";i:5;s:83:"https://developers.google.com/speed/webp/docs/webp_lossless_bitstream_specification";i:6;s:71:"https://developers.google.com/speed/webp/docs/webp_lossless_alpha_study";i:7;s:56:"https://developers.google.com/speed/webp/docs/webp_study";}}i:62;a:23:{i:0;i:0;i:1;i:14;i:2;s:1:"s";i:3;s:14:"%!PS-Adobe-1.0";i:4;i:0;i:5;i:7;i:6;s:2:"sr";i:7;s:49:"\x25\x25\x45\x4f\x46(\x0d|\x0a|\x0d\x0a|\x0a\x0a)";i:8;s:2:"ps";i:9;a:1:{i:0;s:2:"ps";}i:10;s:22:"application/postscript";i:11;s:20:"com.adobe.postscript";i:12;s:10:"Postscript";i:13;s:3:"1.0";i:14;N;i:15;s:8:"x-fmt/91";i:16;N;i:17;s:16:"Page Description";i:18;N;i:19;s:63:"Postscript is a computer language for creating vector graphics.";i:20;s:4:"Text";i:21;N;i:22;a:6:{i:0;s:122:"https://www.nationalarchives.gov.uk/PRONOM/Format/proFormatSearch.aspx?status=detailReport&id=138&strPageToDisplay=summary";i:1;s:40:"https://en.wikipedia.org/wiki/PostScript";i:2;s:101:"https://web.archive.org/web/20170218093716if_/https://www.adobe.com/products/postscript/pdfs/PLRM.pdf";i:3;s:123:"https://web.archive.org/web/20160305010005if_/http://partners.adobe.com/public/developer/en/ps/PS3010and3011.Supplement.pdf";i:4;s:108:"https://web.archive.org/web/20150321034514if_/http://partners.adobe.com/public/developer/en/font/T1_SPEC.PDF";i:5;s:82:"https://w3-o.cs.hm.edu/users/ruckert/public_html/compiler/ThinkingInPostScript.pdf";}}i:63;a:23:{i:0;i:0;i:1;i:14;i:2;s:2:"sr";i:3;s:72:"\xff\xd8\xff\xe0[\x00-\xff]{2}\x4a\x46\x49\x46\x00\x01\x00[\x00\x01\x02]";i:4;i:0;i:5;i:2;i:6;s:1:"s";i:7;s:2:"ÿÙ";i:8;s:3:"jpg";i:9;a:3:{i:0;s:3:"jpe";i:1;s:4:"jpeg";i:2;s:3:"jpg";}i:10;s:10:"image/jpeg";i:11;s:11:"public.jpeg";i:12;s:28:"JPEG File Interchange Format";i:13;s:4:"1.00";i:14;s:11:"JFIF (1.00)";i:15;s:6:"fmt/42";i:16;N;i:17;s:14:"Image (Raster)";i:18;s:4:"Full";i:19;s:990:"The JPEG File Interchange Format (JFIF) is a file format for storing JPEG-compressed raster images. It was developed by the Independent JPEG Group and C-Cube Microsystems, in the absence of any such format being defined in the JPEG standard, and rapidly became a de facto standard; this is what is commonly referred to as the JPEG file format. A JFIF file comprises a JPEG data stream together with a JFIF marker. It begins with a Start of Image (SOI) marker, immediately followed by a JFIF Application (APP0). This is followed by the JPEG image data, which is terminated by an End of Image (EOI) marker. JFIF supports up to 24-bit colour and uses lossy compression (based on the Discrete Cosine Transform algorithm). Other types of compression are available through JPEG extensions, including progressive image buildup, arithmetic encoding, variable quantization, selective refinement, image tiling, and lossless compression, but these may not be supported by all JFIF readers and writers.";i:20;s:6:"Binary";i:21;s:21:"Big-endian (Motorola)";i:22;a:2:{i:0;s:122:"https://www.nationalarchives.gov.uk/PRONOM/Format/proFormatSearch.aspx?status=detailReport&id=667&strPageToDisplay=summary";i:1;s:58:"https://en.wikipedia.org/wiki/JPEG_File_Interchange_Format";}}i:64;a:23:{i:0;i:0;i:1;i:14;i:2;s:2:"sr";i:3;s:72:"\xff\xd8\xff\xe0[\x00-\xff]{2}\x4a\x46\x49\x46\x00\x01\x01[\x00\x01\x02]";i:4;i:0;i:5;i:2;i:6;s:1:"s";i:7;s:2:"ÿÙ";i:8;s:3:"jpg";i:9;a:3:{i:0;s:3:"jpe";i:1;s:4:"jpeg";i:2;s:3:"jpg";}i:10;s:10:"image/jpeg";i:11;s:11:"public.jpeg";i:12;s:28:"JPEG File Interchange Format";i:13;s:4:"1.01";i:14;s:11:"JFIF (1.01)";i:15;s:6:"fmt/43";i:16;N;i:17;s:14:"Image (Raster)";i:18;s:4:"Full";i:19;s:990:"The JPEG File Interchange Format (JFIF) is a file format for storing JPEG-compressed raster images. It was developed by the Independent JPEG Group and C-Cube Microsystems, in the absence of any such format being defined in the JPEG standard, and rapidly became a de facto standard; this is what is commonly referred to as the JPEG file format. A JFIF file comprises a JPEG data stream together with a JFIF marker. It begins with a Start of Image (SOI) marker, immediately followed by a JFIF Application (APP0). This is followed by the JPEG image data, which is terminated by an End of Image (EOI) marker. JFIF supports up to 24-bit colour and uses lossy compression (based on the Discrete Cosine Transform algorithm). Other types of compression are available through JPEG extensions, including progressive image buildup, arithmetic encoding, variable quantization, selective refinement, image tiling, and lossless compression, but these may not be supported by all JFIF readers and writers.";i:20;s:6:"Binary";i:21;s:21:"Big-endian (Motorola)";i:22;a:2:{i:0;s:122:"https://www.nationalarchives.gov.uk/PRONOM/Format/proFormatSearch.aspx?status=detailReport&id=668&strPageToDisplay=summary";i:1;s:58:"https://en.wikipedia.org/wiki/JPEG_File_Interchange_Format";}}i:65;a:23:{i:0;i:0;i:1;i:14;i:2;s:2:"sr";i:3;s:72:"\xff\xd8\xff\xe0[\x00-\xff]{2}\x4a\x46\x49\x46\x00\x01\x02[\x00\x01\x02]";i:4;i:0;i:5;i:2;i:6;s:1:"s";i:7;s:2:"ÿÙ";i:8;s:3:"jpg";i:9;a:3:{i:0;s:3:"jpe";i:1;s:4:"jpeg";i:2;s:3:"jpg";}i:10;s:10:"image/jpeg";i:11;s:11:"public.jpeg";i:12;s:28:"JPEG File Interchange Format";i:13;s:4:"1.02";i:14;s:11:"JFIF (1.02)";i:15;s:6:"fmt/44";i:16;N;i:17;s:14:"Image (Raster)";i:18;s:4:"Full";i:19;s:990:"The JPEG File Interchange Format (JFIF) is a file format for storing JPEG-compressed raster images. It was developed by the Independent JPEG Group and C-Cube Microsystems, in the absence of any such format being defined in the JPEG standard, and rapidly became a de facto standard; this is what is commonly referred to as the JPEG file format. A JFIF file comprises a JPEG data stream together with a JFIF marker. It begins with a Start of Image (SOI) marker, immediately followed by a JFIF Application (APP0). This is followed by the JPEG image data, which is terminated by an End of Image (EOI) marker. JFIF supports up to 24-bit colour and uses lossy compression (based on the Discrete Cosine Transform algorithm). Other types of compression are available through JPEG extensions, including progressive image buildup, arithmetic encoding, variable quantization, selective refinement, image tiling, and lossless compression, but these may not be supported by all JFIF readers and writers.";i:20;s:6:"Binary";i:21;s:21:"Big-endian (Motorola)";i:22;a:2:{i:0;s:122:"https://www.nationalarchives.gov.uk/PRONOM/Format/proFormatSearch.aspx?status=detailReport&id=669&strPageToDisplay=summary";i:1;s:58:"https://en.wikipedia.org/wiki/JPEG_File_Interchange_Format";}}i:66;a:23:{i:0;i:0;i:1;i:14;i:2;s:1:"s";i:3;s:14:"%!PS-Adobe-2.0";i:4;i:0;i:5;i:0;i:6;s:1:"s";i:7;s:0:"";i:8;s:2:"ps";i:9;a:1:{i:0;s:2:"ps";}i:10;s:22:"application/postscript";i:11;s:20:"com.adobe.postscript";i:12;s:10:"Postscript";i:13;s:3:"2.0";i:14;N;i:15;s:9:"x-fmt/406";i:16;N;i:17;s:16:"Page Description";i:18;N;i:19;s:63:"Postscript is a computer language for creating vector graphics.";i:20;s:4:"Text";i:21;N;i:22;a:6:{i:0;s:122:"https://www.nationalarchives.gov.uk/PRONOM/Format/proFormatSearch.aspx?status=detailReport&id=771&strPageToDisplay=summary";i:1;s:40:"https://en.wikipedia.org/wiki/PostScript";i:2;s:101:"https://web.archive.org/web/20170218093716if_/https://www.adobe.com/products/postscript/pdfs/PLRM.pdf";i:3;s:123:"https://web.archive.org/web/20160305010005if_/http://partners.adobe.com/public/developer/en/ps/PS3010and3011.Supplement.pdf";i:4;s:108:"https://web.archive.org/web/20150321034514if_/http://partners.adobe.com/public/developer/en/font/T1_SPEC.PDF";i:5;s:82:"https://w3-o.cs.hm.edu/users/ruckert/public_html/compiler/ThinkingInPostScript.pdf";}}i:67;a:23:{i:0;i:0;i:1;i:14;i:2;s:1:"s";i:3;s:14:"%!PS-Adobe-2.1";i:4;i:0;i:5;i:0;i:6;s:1:"s";i:7;s:0:"";i:8;s: