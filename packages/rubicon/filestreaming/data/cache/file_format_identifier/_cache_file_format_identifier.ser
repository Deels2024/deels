t/public_html/compiler/ThinkingInPostScript.pdf";}}i:69;a:23:{i:0;i:0;i:1;i:14;i:2;s:1:"s";i:3;s:14:"%!PS-Adobe-3.1";i:4;i:0;i:5;i:0;i:6;s:1:"s";i:7;s:0:"";i:8;s:2:"ps";i:9;a:1:{i:0;s:2:"ps";}i:10;s:22:"application/postscript";i:11;s:20:"com.adobe.postscript";i:12;s:10:"Postscript";i:13;s:3:"3.1";i:14;N;i:15;s:7:"fmt/501";i:16;N;i:17;s:16:"Page Description";i:18;N;i:19;s:63:"Postscript is a computer language for creating vector graphics.";i:20;N;i:21;N;i:22;a:6:{i:0;s:123:"https://www.nationalarchives.gov.uk/PRONOM/Format/proFormatSearch.aspx?status=detailReport&id=1288&strPageToDisplay=summary";i:1;s:40:"https://en.wikipedia.org/wiki/PostScript";i:2;s:101:"https://web.archive.org/web/20170218093716if_/https://www.adobe.com/products/postscript/pdfs/PLRM.pdf";i:3;s:123:"https://web.archive.org/web/20160305010005if_/http://partners.adobe.com/public/developer/en/ps/PS3010and3011.Supplement.pdf";i:4;s:108:"https://web.archive.org/web/20150321034514if_/http://partners.adobe.com/public/developer/en/font/T1_SPEC.PDF";i:5;s:82:"https://w3-o.cs.hm.edu/users/ruckert/public_html/compiler/ThinkingInPostScript.pdf";}}i:70;a:23:{i:0;i:0;i:1;i:13;i:2;s:1:"s";i:3;s:13:"8BPS␀␀␀␀␀␀␀␀";i:4;i:0;i:5;i:0;i:6;s:1:"s";i:7;s:0:"";i:8;s:3:"psd";i:9;a:2:{i:0;s:3:"pdd";i:1;s:3:"psd";}i:10;s:25:"image/vnd.adobe.photoshop";i:11;s:25:"com.adobe.photoshop-image";i:12;s:15:"Adobe Photoshop";i:13;N;i:14;N;i:15;s:8:"x-fmt/92";i:16;N;i:17;s:14:"Image (Raster)";i:18;N;i:19;s:229:"Adobe Photoshop is a raster graphics editor developed and published by Adobe Systems for Windows and OS X. Files natively produced by Adobe PhotoDeluxe (extension pdd) also appear to be based upon the Adobe Photoshop file format.";i:20;s:4:"Text";i:21;N;i:22;a:2:{i:0;s:122:"https://www.nationalarchives.gov.uk/PRONOM/Format/proFormatSearch.aspx?status=detailReport&id=139&strPageToDisplay=summary";i:1;s:45:"https://en.wikipedia.org/wiki/Adobe_Photoshop";}}i:71;a:23:{i:0;i:0;i:1;i:12;i:2;s:2:"sr";i:3;s:46:"\x52\x49\x46\x46[\x00-\xff]{4}\x41\x56\x49\x20";i:4;i:0;i:5;i:0;i:6;s:1:"s";i:7;s:0:"";i:8;s:3:"avi";i:9;a:1:{i:0;s:3:"avi";}i:10;s:15:"video/x-msvideo";i:11;s:10:"public.avi";i:12;s:30:"Audio/Video Interleaved Format";i:13;N;i:14;s:13:"AVI (Generic)";i:15;s:5:"fmt/5";i:16;N;i:17;s:12:"Audio, Video";i:18;s:4:"Full";i:19;s:470:"Audio Video Interleave (also Audio Video Interleaved), known by its initials AVI and the .avi filename extension is a multimedia container format introduced by Microsoft in November 1992 as part of its Video for Windows software. AVI files can contain both audio and video data in a file container that allows synchronous audio-with-video playback. Like the DVD video format, AVI files support multiple streaming audio and video, although these features are seldom used.";i:20;s:6:"Binary";i:21;s:21:"Little-endian (Intel)";i:22;a:5:{i:0;s:122:"https://www.nationalarchives.gov.uk/PRONOM/Format/proFormatSearch.aspx?status=detailReport&id=655&strPageToDisplay=summary";i:1;s:52:"https://en.wikipedia.org/wiki/Audio_Video_Interleave";i:2;s:69:"https://docs.microsoft.com/en-us/previous-versions//ms779636(v=vs.85)";i:3;s:69:"https://docs.microsoft.com/en-us/previous-versions//ms783421(v=vs.85)";i:4;s:56:"http://www.alexander-noe.com/video/documentation/avi.pdf";}}i:72;a:23:{i:0;i:0;i:1;i:12;i:2;s:2:"sr";i:3;s:46:"\x46\x4f\x52\x34[\x00-\xff]{4}\x43\x49\x4d\x47";i:4;i:0;i:5;i:0;i:6;s:1:"s";i:7;s:0:"";i:8;s:3:"iff";i:9;a:2:{i:0;s:3:"ico";i:1;s:3:"iff";}i:10;N;i:11;N;i:12;s:19:"Maya IFF Image File";i:13;N;i:14;N;i:15;s:8:"fmt/1169";i:16;N;i:17;s:14:"Image (Raster)";i:18;N;i:19;s:131:"Maya is a 3D graphics application published by Autodesk. Maya IFF files are raster images used for images and textures within Maya.";i:20;N;i:21;N;i:22;a:1:{i:0;s:123:"https://www.nationalarchives.gov.uk/PRONOM/Format/proFormatSearch.aspx?status=detailReport&id=1979&strPageToDisplay=summary";}}i:73;a:23:{i:0;i:0;i:1;i:12;i:2;s:1:"s";i:3;s:12:"8BPS␀␀␀␀␀␀␀";i:4;i:0;i:5;i:0;i:6;s:1:"s";i:7;s:0:"";i:8;s:3:"psb";i:9;a:1:{i:0;s:3:"psb";}i:10;s:25:"image/vnd.adobe.photoshop";i:11;s:25:"com.adobe.photoshop-image";i:12;s:15:"Adobe Photoshop";i:13;N;i:14;N;i:15;s:7:"fmt/996";i:16;N;i:17;s:14:"Image (Raster)";i:18;N;i:19;s:217:"Adobe Photoshop is a raster graphics editor developed and published by Adobe Systems. The Large Document Format supports documents of up to 300,000 pixels in any dimension as opposed to the PSD limit of 30,000 pixels.";i:20;N;i:21;N;i:22;a:2:{i:0;s:123:"https://www.nationalarchives.gov.uk/PRONOM/Format/proFormatSearch.aspx?status=detailReport&id=1801&strPageToDisplay=summary";i:1;s:45:"https://en.wikipedia.org/wiki/Adobe_Photoshop";}}i:74;a:23:{i:0;i:0;i:1;i:12;i:2;s:2:"sr";i:3;s:46:"\x52\x49\x46\x46[\x00-\xff]{4}\x57\x41\x56\x45";i:4;i:0;i:5;i:0;i:6;s:1:"s";i:7;s:0:"";i:8;s:3:"wav";i:9;a:1:{i:0;s:3:"wav";}i:10;s:11:"audio/x-wav";i:11;N;i:12;s:37:"Waveform Audio File Format (WAVE/WAV)";i:13;N;i:14;N;i:15;N;i:16;s:4:"WAVE";i:17;s:5:"Audio";i:18;s:4:"Full";i:19;s:584:"Waveform Audio File Format (WAVE, or WAV due to its filename extension) is an audio file format standard, developed by IBM and Microsoft, for storing an audio bitstream on PCs. It is an application of the Resource Interchange File Format (RIFF) bitstream format method for storing data in "chunks", and thus is also close to the 8SVX and the AIFF format used on Amiga and Macintosh computers, respectively. It is the main format used on Microsoft Windows systems for raw and typically uncompressed audio. The usual bitstream encoding is the linear pulse-code modulation (LPCM) format.";i:20;s:6:"Binary";i:21;s:21:"Little-endian (Intel)";i:22;a:2:{i:0;s:33:"https://en.wikipedia.org/wiki/WAV";i:1;s:67:"http://www-mmsp.ece.mcgill.ca/Documents/AudioFormats/WAVE/WAVE.html";}}i:75;a:23:{i:0;i:0;i:1;i:10;i:2;s:2:"sr";i:3;s:40:"\x00\x00[\x00-\xff]{6}\x01[\x01\x04\x08]";i:4;i:0;i:5;i:0;i:6;s:1:"s";i:7;s:0:"";i:8;s:3:"bmp";i:9;a:2:{i:0;s:3:"bmp";i:1;s:3:"ddb";}i:10;s:9:"image/bmp";i:11;s:17:"com.microsoft.bmp";i:12;s:14:"Windows Bitmap";i:13;s:3:"1.0";i:14;s:9:"BMP (1.0)";i:15;s:7:"fmt/114";i:16;N;i:17;s:14:"Image (Raster)";i:18;N;i:19;s:311:"The BMP file format, also known as bitmap image file, device independent bitmap (DIB) file format and bitmap, is a raster graphics image file format used to store bitmap digital images, independently of the display device (such as a graphics adapter), especially on Microsoft Windows and OS/2 operating systems.";i:20;s:6:"Binary";i:21;s:21:"Little-endian (Intel)";i:22;a:3:{i:0;s:122:"https://www.nationalarchives.gov.uk/PRONOM/Format/proFormatSearch.aspx?status=detailReport&id=727&strPageToDisplay=summary";i:1;s:45:"https://en.wikipedia.org/wiki/BMP_file_format";i:2;s:93:"https://medium.com/sysf/bits-to-bitmaps-a-simple-walkthrough-of-bmp-image-format-765dc6857393";}}i:76;a:23:{i:0;i:0;i:1;i:10;i:2;s:2:"sr";i:3;s:47:"\x42\x5a\x68[\x00-\xff]\x31\x41\x59\x26\x53\x59";i:4;i:0;i:5;i:0;i:6;s:1:"s";i:7;s:0:"";i:8;s:3:"bz2";i:9;a:1:{i:0;s:3:"bz2";}i:10;s:18:"application/x-bzip";i:11;s:20:"public.archive.bzip2";i:12;s:24:"BZIP2 Compressed Archive";i:13;N;i:14;N;i:15;s:9:"x-fmt/268";i:16;N;i:17;s:9:"Aggregate";i:18;N;i:19;s:422:"bzip2 is a free and open-source file compression program that uses the Burrowsâ€“Wheeler algorithm. It only compresses single files and is not a file archiver. It is developed by Julian Seward and maintained by Federico Mena. Seward made the first public release of bzip2, version 0.15, in July 1996. The compressor's stability and popularity grew over the next several years, and Seward released version 1.0 in late 2000.";i:20;s:4:"Text";i:21;N;i:22;a:3:{i:0;s:122:"https://www.nationalarchives.gov.uk/PRONOM/Format/proFormatSearch.aspx?status=detailReport&id=388&strPageToDisplay=summary";i:1;s:35:"https://en.wikipedia.org/wiki/Bzip2";i:2;s:66:"https://github.com/dsnet/compress/blob/master/doc/bzip2-format.pdf";}}i:77;a:23:{i:0;i:0;i:1;i:9;i:2;s:2:"sr";i:3;s:48:"\x50\x35[\x20\x0d\x0a][\x30-\x39\x20\x0a\x0d]{6}";i:4;i:0;i:5;i:0;i:6;s:1:"s";i:7;s:0:"";i:8;s:3:"pgm";i:9;a:2:{i:0;s:3:"pgm";i:1;s:4:"pgmb";}i:10;s:24:"image/x-portable-graymap";i:11;N;i:12;s:42:"Portable Grey Map - Binary without comment";i:13;N;i:14;N;i:15;s:7:"fmt/406";i:16;N;i:17;N;i:18;N;i:19;s:400:"Several graphics formats are used and defined by the Netpbm project. The portable pixmap format (PPM), the portable graymap format (PGM) and the portable bitmap format (PBM) are image file formats designed to be easily exchanged between platforms. They are also sometimes referred to collectively as the portable anymap format (PNM), not to be confused with the related portable arbitrary map format.";i:20;s:6:"Binary";i:21;N;i:22;a:2:{i:0;s:123:"https://www.nationalarchives.gov.uk/PRONOM/Format/proFormatSearch.aspx?status=detailReport&id=1154&strPageToDisplay=summary";i:1;s:36:"https://en.wikipedia.org/wiki/Netpbm";}}i:78;a:23:{i:0;i:0;i:1;i:9;i:2;s:2:"sr";i:3;s:48:"\x50\x36[\x20\x0d\x0a][\x30-\x39\x20\x0a\x0d]{6}";i:4;i:0;i:5;i:0;i:6;s:1:"s";i:7;s:0:"";i:8;s:3:"ppm";i:9;a:2:{i:0;s:3:"ppm";i:1;s:4:"ppmb";}i:10;s:23:"image/x-portable-pixmap";i:11;N;i:12;s:43:"Portable Pixel Map - Binary without comment";i:13;N;i:14;N;i:15;s:7:"fmt/408";i:16;N;i:17;N;i:18;N;i:19;s:400:"Several graphics formats are used and defined by the Netpbm project. The portable pixmap format (PPM), the portable graymap format (PGM) and the portable bitmap format (PBM) are image file formats designed to be easily exchanged between platforms. They are also sometimes referred to collectively as the portable anymap format (PNM), not to be confused with the related portable arbitrary map format.";i:20;s:6:"Binary";i:21;N;i:22;a:2:{i:0;s:123:"https://www.nationalarchives.gov.uk/PRONOM/Format/proFormatSearch.aspx?status=detailReport&id=1156&strPageToDisplay=summary";i:1;s:36:"https://en.wikipedia.org/wiki/Netpbm";}}i:79;a:23:{i:0;i:0;i:1;i:8;i:2;s:1:"s";i:3;s:8:"%PDF-1.0";i:4;i:0;i:5;i:1024;i:6;s:2:"sr";i:7;s:39:"\x25\x25\x45\x4f\x46[\x00-\xff]{0,1019}";i:8;s:3:"pdf";i:9;a:1:{i:0;s:3:"pdf";}i:10;s:15:"application/pdf";i:11;s:13:"com.adobe.pdf";i:12;s:42:"Acrobat PDF 1.0 - Portable Document Format";i:13;s:3:"1.0";i:14;s:9:"PDF (1.0)";i:15;s:6:"fmt/14";i:16;N;i:17;s:16:"Page Description";i:18;N;i:19;s:543:"The Portable Document Format (PDF) is a file format developed by Adobe in 1993 to present documents, including text formatting and images, in a manner independent of application software, hardware, and operating systems. Based on the PostScript language, each PDF file encapsulates a complete description of a fixed-layout flat document, including the text, fonts, vector graphics, raster images and other information needed to display it. PDF was standardized as ISO 32000 in 2008, and no longer requires any royalties for its implementation.";i:20;s:6:"Binary";i:21;s:21:"Big-endian (Motorola)";i:22;a:11:{i:0;s:122:"https://www.nationalarchives.gov.uk/PRONOM/Format/proFormatSearch.aspx?status=detailReport&id=613&strPageToDisplay=summary";i:1;s:33:"https://en.wikipedia.org/wiki/PDF";i:2;s:76:"https://www.adobe.com/content/dam/acom/en/devnet/pdf/pdfs/PDFReference13.pdf";i:3;s:91:"https://www.adobe.com/content/dam/acom/en/devnet/pdf/pdf_reference_archive/PDFReference.pdf";i:4;s:96:"https://www.adobe.com/content/dam/acom/en/devnet/pdf/pdf_reference_archive/PDFReference15_v6.pdf";i:5;s:93:"https://www.adobe.com/content/dam/acom/en/devnet/pdf/pdf_reference_archive/PDFReference16.pdf";i:6;s:83:"https://www.adobe.com/content/dam/acom/en/devnet/acrobat/pdfs/pdf_reference_1-7.pdf";i:7;s:79:"https://www.adobe.com/content/dam/acom/en/devnet/acrobat/pdfs/PDF32000_2008.pdf";i:8;s:128:"https://web.archive.org/web/20130902000323if_/http://cdn.parleys.com/p/5148922a0364bc17fc56c6e5/iSUM2012_00_LRO_presentation.pdf";i:9;s:111:"https://web.archive.org/web/20180730100811if_/https://www.immagic.com/eLibrary/ARCHIVES/TECH/ADOBE/A070914X.pdf";i:10;s:71:"http://www.cs.nott.ac.uk/~psadb1/Publications/Download/2002/Hardy02.pdf";}}i:80;a:23:{i:0;i:0;i:1;i:8;i:2;s:1:"s";i:3;s:8:"%PDF-1.1";i:4;i:0;i:5;i:1024;i:6;s:2:"sr";i:7;s:39:"\x25\x25\x45\x4f\x46[\x00-\xff]{0,1019}";i:8;s:3:"pdf";i:9;a:1:{i:0;s:3:"pdf";}i:10;s:15:"application/pdf";i:11;s:13:"com.adobe.pdf";i:12;s:42:"Acrobat PDF 1.1 - Portable Document Format";i:13;s:3:"1.1";i:14;s:9:"PDF (1.1)";i:15;s:6:"fmt/15";i:16;N;i:17;s:16:"Page Description";i:18;N;i:19;s:543:"The Portable Document Format (PDF) is a file format developed by Adobe in 1993 to present documents, including text formatting and images, in a manner independent of application software, hardware, and operating systems. Based on the PostScript language, each PDF file encapsulates a complete description of a fixed-layout flat document, including the text, fonts, vector graphics, raster images and other information needed to display it. PDF was standardized as ISO 32000 in 2008, and no longer requires any royalties for its implementation.";i:20;s:6:"Binary";i:21;s:21:"Big-endian (Motorola)";i:22;a:11:{i:0;s:122:"https://www.nationalarchives.gov.uk/PRONOM/Format/proFormatSearch.aspx?status=detailReport&id=614&strPageToDisplay=summary";i:1;s:33:"https://en.wikipedia.org/wiki/PDF";i:2;s:76:"https://www.adobe.com/content/dam/acom/en/devnet/pdf/pdfs/PDFReference13.pdf";i:3;s:91:"https://www.adobe.com/content/dam/acom/en/devnet/pdf/pdf_reference_archive/PDFReference.pdf";i:4;s:96:"https://www.adobe.com/content/dam/acom/en/devnet/pdf/pdf_reference_archive/PDFReference15_v6.pdf";i:5;s:93:"https://www.adobe.com/content/dam/acom/en/devnet/pdf/pdf_reference_archive/PDFReference16.pdf";i:6;s:83:"https://www.adobe.com/content/dam/acom/en/devnet/acrobat/pdfs/pdf_reference_1-7.pdf";i:7;s:79:"https://www.adobe.com/content/dam/acom/en/devnet/acrobat/pdfs/PDF32000_2008.pdf";i:8;s:128:"https://web.archive.org/web/20130902000323if_/http://cdn.parleys.com/p/5148922a0364bc17fc56c6e5/iSUM2012_00_LRO_presentation.pdf";i:9;s:111:"https://web.archive.org/web/20180730100811if_/https://www.immagic.com/eLibrary/ARCHIVES/TECH/ADOBE/A070914X.pdf";i:10;s:71:"http://www.cs.nott.ac.uk/~psadb1/Publications/Download/2002/Hardy02.pdf";}}i:81;a:23:{i:0;i:0;i:1;i:8;i:2;s:1:"s";i:3;s:8:"%PDF-1.2";i:4;i:0;i:5;i:1024;i:6;s:2:"sr";i:7;s:39:"\x25\x25\x45\x4f\x46[\x00-\xff]{0,1019}";i:8;s:3:"pdf";i:9;a:1:{i:0;s:3:"pdf";}i:10;s:15:"application/pdf";i:11;s:13:"com.adobe.pdf";i:12;s:42:"Acrobat PDF 1.2 - Portable Document Format";i:13;s:3:"1.2";i:14;s:9:"PDF (1.2)";i:15;s:6:"fmt/16";i:16;N;i:17;s:16:"Page Description";i:18;N;i:19;s:543:"The Portable Document Format (PDF) is a file format developed by Adobe in 1993 to present documents, including text formatting and images, in a manner independent of application software, hardware, and operating systems. Based on the PostScript language, each PDF file encapsulates a complete description of a fixed-layout flat document, including the text, fonts, vector graphics, raster images and other information needed to display it. PDF was standardized as ISO 32000 in 2008, and no longer requires any royalties for its implementation.";i:20;s:6:"Binary";i:21;s:21:"Big-endian (Motorola)";i:22;a:11:{i:0;s:122:"https://www.nationalarchives.gov.uk/PRONOM/Format/proFormatSearch.aspx?status=detailReport&id=615&strPageToDisplay=summary";i:1;s:33:"https://en.wikipedia.org/wiki/PDF";i:2;s:76:"https://www.adobe.com/content/dam/acom/en/devnet/pdf/pdfs/PDFReference13.pdf";i:3;s:91:"https://www.adobe.com/content/dam/acom/en/devnet/pdf/pdf_reference_archive/PDFReference.pdf";i:4;s:96:"https://www.adobe.com/content/dam/acom/en/devnet/pdf/pdf_reference_archive/PDFReference15_v6.pdf";i:5;s:93:"https://www.adobe.com/content/dam/acom/en/devnet/pdf/pdf_reference_archive/PDFReference16.pdf";i:6;s:83:"https://www.adobe.com/content/dam/acom/en/devnet/acrobat/pdfs/pdf_reference_1-7.pdf";i:7;s:79:"https://www.adobe.com/content/dam/acom/en/devnet/acrobat/pdfs/PDF32000_2008.pdf";i:8;s:128:"https://web.archive.org/web/20130902000323if_/http://cdn.parleys.com/p/5148922a0364bc17fc56c6e5/iSUM2012_00